# LLM Inference (external OpenAI-compatible endpoint)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL_NAME=google/gemma-4-31b-it
VLLM_REQUEST_TIMEOUT=300

# Embeddings
EMBEDDING_MODE=api                              # "api" (external endpoint) or "local" (sentence-transformers)
EMBEDDING_API_URL=http://localhost:8000/v1       # OpenAI-compatible /v1/embeddings endpoint
EMBEDDING_MODEL_NAME=intfloat/e5-large-v2
EMBEDDING_DEVICE=cpu                             # only used when EMBEDDING_MODE=local

# Vector Store (LanceDB — embedded, no server needed)
LANCEDB_PATH=data/lancedb
LANCEDB_TABLE_NAME=chunks

# Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480
API_KEYS=dev-key-1,dev-key-2

# LDAP (Phase 1: simulated; real LDAP in production)
LDAP_ENABLED=false

# Metadata DB
DATABASE_URL=sqlite+aiosqlite:///./data/metadata.db

# Database Registry (for text-to-SQL, comma-separated name=url pairs)
REGISTERED_DATABASES=finance_db=sqlite+aiosqlite:///./data/finance.db

# MCP Server
MCP_SERVER_NAME=rag-knowledge-service
MCP_PORT=8090

# Audit
AUDIT_LOG_PATH=data/audit.jsonl
