# LLM — defaults to OpenAI API (works out of the box with an API key)
VLLM_BASE_URL=https://api.openai.com/v1
VLLM_MODEL_NAME=gpt-4.1-mini
VLLM_API_KEY=sk-your-key-here
VLLM_REQUEST_TIMEOUT=120
# For local models (llama.cpp, vLLM, Ollama), change to:
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_MODEL_NAME=your-model-name
# VLLM_API_KEY=
# VLLM_REQUEST_TIMEOUT=300

# TLS for outbound model API calls (LLM + embeddings). Set false for private CAs
# or self-signed endpoints. Prefer Admin → Settings → Models → "Ignore SSL
# certificate errors" at runtime (persists to data/settings.json).
SSL_VERIFY=true

# ---------------------------------------------------------------------------
# Docker build (MITM / corporate proxy / private PyPI) — used by docker-compose
# ---------------------------------------------------------------------------
# 1. Copy your TLS inspection CA into certs/Trusted_Root_CAs.pem before build.
# 2. Uncomment proxy vars if the proxy is explicit (not transparent).
# HTTP_PROXY=http://proxy.example:8080
# HTTPS_PROXY=http://proxy.example:8080
# NO_PROXY=localhost,127.0.0.1
#
# pip: skip TLS verify for these hosts (space-separated). docker-compose defaults
# already include the common public PyPI hosts.
# PIP_TRUSTED_HOST=pypi.org files.pythonhosted.org pypi.python.org pythonhosted.org download.pytorch.org
#
# Private package mirror (air-gap / Artifactory / Nexus):
# PIP_INDEX_URL=https://pypi.internal.example/simple
# PIP_EXTRA_INDEX_URL=
# TORCH_CPU_INDEX=https://pypi.internal.example/simple
# PIP_TRUSTED_HOST=pypi.internal.example files.internal.example
#
# Hugging Face model bake during image build (often blocked on corp nets):
# SAURON_PREFETCH_INSECURE_SSL=1
# SKIP_PDF_MODEL_PREFETCH=1
# SAURON_PREFETCH_ALLOW_FAIL=1


# Embeddings (default: local CPU, no server or GPU needed)
EMBEDDING_MODE=local                             # "local" (sentence-transformers, CPU) or "api" (external endpoint)
EMBEDDING_MODEL_NAME=nomic-ai/nomic-embed-text-v1  # local default (768 dims, runs on CPU)
# To use an external OpenAI-compatible embedding provider instead of local CPU:
# EMBEDDING_MODE=api
# EMBEDDING_API_URL=http://your-embedding-host:8000/v1
# EMBEDDING_MODEL_NAME=<provider-model-name>

# Vector Store (LanceDB — embedded, no server needed)
LANCEDB_PATH=data/lancedb
LANCEDB_TABLE_NAME=chunks

# Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480
# Bootstrap keys (comma-separated). Also imported into Applications → "legacy" on first boot.
# Prefer Admin → Security → Applications & API Keys for per-app keys in multi-client setups.
API_KEYS=dev-key-1,dev-key-2

# LDAP (Phase 1: simulated; real LDAP in production)
LDAP_ENABLED=false

# Metadata DB
DATABASE_URL=sqlite+aiosqlite:///./data/metadata.db

# Embedded figure extraction (PDF images → OCR / vision → text or tables)
# Requires tesseract binary for OCR; vision uses VLLM_BASE_URL multimodal chat API.
FIGURE_EXTRACTION_ENABLED=true
FIGURE_MAX_PER_DOC=20
FIGURE_OCR_FIRST=true
FIGURE_VISION_TIMEOUT_SECONDS=90
# FIGURE_MIN_WIDTH=80
# FIGURE_MIN_HEIGHT=80

# Knowledge graph extract (LightRAG) — large PDFs need long budgets
# LLM_CONCURRENCY=4          # raise if your LLM server can handle it (biggest speed lever)
# KG_CHUNK_TOKEN_SIZE=1200   # larger = fewer extract calls (default 1200; old was 500)
# KG_EXTRACT_TIMEOUT_SECONDS=0   # 0 = adaptive from doc size
# KG_EXTRACT_TIMEOUT_MAX_SECONDS=3600
# KG_EXTRACT_MAX_RETRIES=1       # full retries re-run all chunks — keep low

# Database Registry (for text-to-SQL, comma-separated name=url pairs)
REGISTERED_DATABASES=finance_db=sqlite+aiosqlite:///./data/finance.db

# SharePoint Integration (future — fill in when ready)
# SHAREPOINT_TENANT_ID=your-tenant-id
# SHAREPOINT_CLIENT_ID=your-app-registration-client-id
# SHAREPOINT_CLIENT_SECRET=your-client-secret
# SHAREPOINT_SITE_URL=https://contoso.sharepoint.com/sites/docs
# SHAREPOINT_SYNC_INTERVAL=3600
# SHAREPOINT_DOC_LIBRARY=Shared Documents

# MCP Server
MCP_SERVER_NAME=sauron
MCP_PORT=8090

# Audit
AUDIT_LOG_PATH=data/audit.jsonl
