# LLM — defaults to OpenAI API (works out of the box with an API key)
VLLM_BASE_URL=https://api.openai.com/v1
VLLM_MODEL_NAME=gpt-4.1-mini
VLLM_API_KEY=sk-your-key-here
VLLM_REQUEST_TIMEOUT=120
# For local models (llama.cpp, vLLM, Ollama), change to:
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_MODEL_NAME=your-model-name
# VLLM_API_KEY=
# VLLM_REQUEST_TIMEOUT=300

# Final-answer temperature (0–2). Existing installations keep 0.1; try 1.0 for Gemma 4 thinking.
LLM_ANSWER_TEMPERATURE=0.1

# Final-answer thinking: default omits the request control (preserves provider behavior).
# enabled/disabled require supported provider request controls; see docs/thinking.md.
LLM_ANSWER_THINKING=default
# auto verifies OpenRouter metadata. vllm_template is an explicit server capability choice.
LLM_REASONING_ADAPTER=auto

# TLS for outbound model API calls (LLM + embeddings). Set false for private CAs
# or self-signed endpoints. Prefer Admin → Settings → Models → "Ignore SSL
# certificate errors" at runtime (persists to data/settings.json).
SSL_VERIFY=true

# ---------------------------------------------------------------------------
# Docker build (MITM / corporate proxy / private PyPI) — used by docker-compose
# ---------------------------------------------------------------------------
# 1. Copy your TLS inspection CA into certs/Trusted_Root_CAs.pem before build.
# 2. Uncomment proxy vars if the proxy is explicit (not transparent).
# HTTP_PROXY=http://proxy.example:8080
# HTTPS_PROXY=http://proxy.example:8080
# NO_PROXY=localhost,127.0.0.1
#
# pip: skip TLS verify for these hosts (space-separated). docker-compose defaults
# already include the common public PyPI hosts.
# PIP_TRUSTED_HOST=pypi.org files.pythonhosted.org pypi.python.org pythonhosted.org download.pytorch.org
#
# Private package mirror (air-gap / Artifactory / Nexus):
# PIP_INDEX_URL=https://pypi.internal.example/simple
# PIP_EXTRA_INDEX_URL=
# TORCH_CPU_INDEX=https://pypi.internal.example/simple
# PIP_TRUSTED_HOST=pypi.internal.example files.internal.example
#
# Hugging Face model bake during image build (REQUIRED for offline runtime).
# Build downloads: nomic embeddings, cross-encoders, YOLOX layout, table-transformer.
# Enterprise roots are used with verification enabled. Set this to 1 only as a
# short-lived diagnostic if the supplied CA chain is incomplete.
# SAURON_PREFETCH_INSECURE_SSL=0
# SKIP_HF_MODEL_PREFETCH=0
# SAURON_PREFETCH_ALLOW_FAIL=0
# EMBEDDING_MODEL_NAME=nomic-ai/nomic-embed-text-v1
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
#
# Artifactory / corporate Hugging Face remote (used only at image build for bake):
# HF_ENDPOINT=https://artifactory.example.com/artifactory/api/huggingfaceml/huggingface-remote
# HF_TOKEN=your-artifactory-or-hf-token
# HUGGING_FACE_HUB_TOKEN=   # optional alias; defaults to HF_TOKEN in compose
#
# Air-gap: pre-populate ./hf-cache from a machine with HF access, then compose build.


# Embeddings (default: local CPU, no server or GPU needed)
EMBEDDING_MODE=local                             # "local" (sentence-transformers, CPU) or "api" (external endpoint)
EMBEDDING_MODEL_NAME=nomic-ai/nomic-embed-text-v1  # local default (768 dims, runs on CPU)
EMBEDDING_BATCH_SIZE=4                           # local batch limit for every chunk tier
EMBEDDING_CPU_THREADS=0                          # 0 = auto, respects affinity/container quota
EMBEDDING_CPU_INTEROP_THREADS=1                  # parallel model operations
EMBEDDING_WORKER_MEMORY_MB=4096                  # monitored worker budget; container headroom also reserved
EMBEDDING_WORKER_TIMEOUT_SECONDS=1200            # per request, includes cold loading
EMBEDDING_WORKER_IDLE_SECONDS=300                # keep model warm between requests
# To use an external OpenAI-compatible embedding provider instead of local CPU:
# EMBEDDING_MODE=api
# EMBEDDING_API_URL=http://your-embedding-host:8000/v1
# EMBEDDING_MODEL_NAME=<provider-model-name>

# Vector Store (LanceDB — embedded, no server needed)
LANCEDB_PATH=data/lancedb
LANCEDB_TABLE_NAME=chunks

# Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480
# Bootstrap keys (comma-separated). Also imported into Applications → "legacy" on first boot.
# Prefer Admin → Security → Applications & API Keys for per-app keys in multi-client setups.
# Generate a unique bootstrap key, or create application keys after admin login.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

# LDAP (Phase 1: simulated; real LDAP in production)
LDAP_ENABLED=false

# Metadata DB
DATABASE_URL=sqlite+aiosqlite:///./data/metadata.db

# File parsing/OCR runs in one disposable subprocess inside the API container.
# Linux address-space limit, also capped at half of a finite container memory limit.
EXTRACTION_MEMORY_MB=4096
EXTRACTION_TIMEOUT_SECONDS=1200
EXTRACTION_MAX_RESULT_MB=32
# IPC scratch files are removed after each extraction.
EXTRACTION_WORK_DIR=data/extraction

# Embedded figure extraction (PDF/Word/PowerPoint/Excel images → OCR / vision → text or tables)
# Requires tesseract binary for OCR; vision uses VLLM_BASE_URL multimodal chat API.
FIGURE_EXTRACTION_ENABLED=true
# Maximum distinct images analysed per document; repeated placements reuse analysis. 0 = unlimited.
FIGURE_MAX_PER_DOC=20
FIGURE_OCR_FIRST=true
FIGURE_VISION_TIMEOUT_SECONDS=90
# FIGURE_MIN_WIDTH=80
# FIGURE_MIN_HEIGHT=80

# Knowledge graph extract (LightRAG) — large PDFs need long budgets
# LLM_CONCURRENCY=4          # raise if your LLM server can handle it (biggest speed lever)
# KG_CHUNK_TOKEN_SIZE=1200   # larger = fewer extract calls (default 1200; old was 500)
# KG_EXTRACT_TIMEOUT_SECONDS=0   # 0 = adaptive from doc size
# KG_EXTRACT_TIMEOUT_MAX_SECONDS=3600
# KG_EXTRACT_MAX_RETRIES=1       # full retries re-run all chunks — keep low

# Database Registry (for text-to-SQL, comma-separated name=url pairs)
REGISTERED_DATABASES=finance_db=sqlite+aiosqlite:///./data/finance.db

# SharePoint Integration (future — fill in when ready)
# SHAREPOINT_TENANT_ID=your-tenant-id
# SHAREPOINT_CLIENT_ID=your-app-registration-client-id
# SHAREPOINT_CLIENT_SECRET=your-client-secret
# SHAREPOINT_SITE_URL=https://contoso.sharepoint.com/sites/docs
# SHAREPOINT_SYNC_INTERVAL=3600
# SHAREPOINT_DOC_LIBRARY=Shared Documents

# Native MCP server (same FastAPI process and port 8080)
MCP_SERVER_NAME=sauron
MCP_ENABLED=true
MCP_PATH=/mcp
MCP_STATELESS_HTTP=true
# Optional signed identity: must match OpenWebUI
# FORWARD_USER_INFO_HEADER_JWT_SECRET. Leave empty for username/group mode.
MCP_OPENWEBUI_JWT_SECRET=
# Accept username/group headers from the trusted API-key holder without a
# shared JWT secret. Can be disabled live in Admin -> All Settings.
MCP_OPENWEBUI_TRUST_HEADERS=true
MCP_OPENWEBUI_USERNAME_HEADER=X-Sauron-Username
MCP_OPENWEBUI_GROUPS_HEADER=X-Sauron-User-Groups
# Sauron's ALL group bypasses ACL filtering. Keep disabled for forwarded groups.
MCP_OPENWEBUI_ALLOW_ALL_GROUP=false

# Only for optional signed forwarding, configure these on OpenWebUI:
# ENABLE_FORWARD_USER_INFO_HEADERS=true
# FORWARD_USER_INFO_HEADER_JWT_SECRET=<same value as MCP_OPENWEBUI_JWT_SECRET>
# WEBUI_SECRET_KEY=<persistent OpenWebUI secret>
# In Admin Settings -> External Tools, use MCP (Streamable HTTP), URL /mcp,
# Authentication=None, and custom headers X-API-Key plus
# X-Sauron-User-Groups={{USER_GROUPS}}.
# In default header mode also add X-Sauron-Username={{USER_EMAIL}} and leave
# FORWARD_USER_INFO_HEADER_JWT_SECRET unset on OpenWebUI. No forwarding env
# variables are needed when all three headers are configured on the connection.

# Audit
AUDIT_LOG_PATH=data/audit.jsonl

# Authenticated original-file downloads through OpenWebUI (opt-in private storage)
SOURCE_ORIGINALS_DIR=
SOURCE_ORIGINALS_MAX_MB=2048
SOURCE_DOWNLOAD_WEBUI_URL=
SOURCE_DOWNLOAD_JWT_SECRET=

# Inline source PNGs in ordinary OpenWebUI/Markdown answers (opt-in).
# Public means browser-reachable; an internal HTTPS hostname is fine.
# Include any reverse-proxy prefix. Both URL and signing secret are required.
FIGURE_PUBLIC_BASE_URL=
# Unset/empty uses the control-panel lifetime (default 900 seconds).
FIGURE_LINK_TTL_SECONDS=
# Generate a dedicated random secret: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Keep identical on every Sauron replica. Do not share it with browser clients.
FIGURE_LINK_SIGNING_SECRET=
ANSWER_IMAGES=auto
ANSWER_MAX_IMAGES=2

# Standalone and Visio-embedded EMF -> PNG inside the extraction worker.
# Also available under Admin > All settings > Document processing.
EMF_ENABLED=true
EMF_MAX_INPUT_MB=32
EMF_MAX_CONVERSIONS_PER_DOC=256
EMF_TIMEOUT_SECONDS=120
EMF_RENDER_MAX_EDGE=4096
EMF_EMBEDDED_MAX_EDGE=1024
EMF_OCR_TIMEOUT_SECONDS=30
# Uses the existing configured multimodal LLM; false keeps PNG + OCR.
EMF_VISION_ENABLED=true

# Conservative source-based Visio label wrapping/alignment repair.
VISIO_REPAIR_TEXT_LAYOUT=true
# Preview font fitting: 0.25–1.0; also preserves a 4-point floor.
VISIO_TEXT_MIN_SCALE=0.5
